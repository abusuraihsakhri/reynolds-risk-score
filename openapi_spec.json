{
  "openapi": "3.1.0",
  "info": {
    "title": "Reynolds Risk Score API",
    "description": "Reference summary for the FastAPI service. The generated /openapi.json is authoritative. Includes published Reynolds risk equations and legacy demonstration endpoints; not clinically validated.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service health status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON operational metrics (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic demonstration response (not an external LLM)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/risk": {
      "post": {
        "summary": "Calculate original sex-specific 10-year Reynolds cardiovascular risk",
        "description": "Research/education only. Female age 45-79 (HbA1c required if diabetic), nondiabetic male age 50-79. Positive numerical inputs; blood pressure mmHg, cholesterol mg/dL, hsCRP mg/L.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sex",
                  "age",
                  "systolic_bp",
                  "total_cholesterol",
                  "hdl_cholesterol",
                  "hs_crp",
                  "smoker",
                  "parental_mi_before_60"
                ],
                "properties": {
                  "sex": {
                    "type": "string",
                    "enum": [
                      "female",
                      "male"
                    ]
                  },
                  "age": {
                    "type": "number"
                  },
                  "systolic_bp": {
                    "type": "number"
                  },
                  "total_cholesterol": {
                    "type": "number"
                  },
                  "hdl_cholesterol": {
                    "type": "number"
                  },
                  "hs_crp": {
                    "type": "number"
                  },
                  "smoker": {
                    "type": "boolean"
                  },
                  "parental_mi_before_60": {
                    "type": "boolean"
                  },
                  "diabetes": {
                    "type": "boolean",
                    "default": false
                  },
                  "hba1c": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "10-year risk (%) and source model"
          },
          "422": {
            "description": "Invalid or out-of-scope clinical input"
          }
        }
      }
    }
  }
}
